# Emergent — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI-compatible API (OpenAI, Groq, DeepSeek, Together, OpenRouter, etc.)
OPENAI_API_KEY=sk-...

# Gemini API (used for fallback when primary and OpenAI fail)
GEMINI_API_KEY=AIza...

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:AABBCCddEEFFggHH...

# Allowed Telegram user IDs (comma-separated)
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Optional: override default model
# EMERGENT_PROVIDER=anthropic  # anthropic | openai | gemini | ollama
# EMERGENT_MODEL=claude-sonnet-4-20250514
# EMERGENT_ROUTING_ENABLED=true
# EMERGENT_FAST_PROVIDER=anthropic
# EMERGENT_FAST_MODEL=claude-haiku-4-5-20251001
# EMERGENT_STRONG_PROVIDER=anthropic
# EMERGENT_STRONG_MODEL=claude-sonnet-4-20250514
# EMERGENT_HAIKU_MODEL=claude-haiku-4-5-20251001
# EMERGENT_SUMMARY_PROVIDER=ollama
# EMERGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMERGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: data directory (default: ./data)
# EMERGENT_DATA_DIR=./data

# Cost budgets (USD per session)
# EMERGENT_COST_BUDGET_SOFT_USD=0.50
# EMERGENT_COST_BUDGET_HARD_USD=2.00

# Fallback providers (comma-separated, ordered)
# EMERGENT_FALLBACK_PROVIDERS=openai,gemini
# Fallback models are configured in config.yaml (fallback_models section)

# Routing mode: heuristic | llm_judge | disabled
# EMERGENT_ROUTING_MODE=heuristic
# EMERGENT_ROUTING_CLASSIFIER_PROVIDER=anthropic
# EMERGENT_ROUTING_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Research worker (optional)
# TAVILY_API_KEY=tvly-...
# GITHUB_TOKEN=ghp_...

# -----------------------------------------------------------------------------
# Social publishing (optional, for MCP-based X/LinkedIn automation)
# -----------------------------------------------------------------------------

# Enable social publisher integration
# SOCIAL_ENABLED=false

# MCP connection (if using an external MCP server for social APIs)
# SOCIAL_MCP_URL=http://127.0.0.1:8080
# SOCIAL_MCP_API_KEY=

# Default account and provider behavior
# SOCIAL_DEFAULT_PLATFORM=x
# SOCIAL_DEFAULT_ACCOUNT_ID=

# X API (OAuth 2.0 user context)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://127.0.0.1:3000/callback/x
# X_ACCESS_TOKEN=
# X_REFRESH_TOKEN=

# LinkedIn API
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://127.0.0.1:3000/callback/linkedin
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_ORGANIZATION_URN=urn:li:organization:123456
